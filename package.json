{
  "name": "marathoner",
  "version": "1.0.1",
  "description": "Track movies and TV shows with automatic upcoming releases, powered by TMDB.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian-plugin",
    "movies",
    "tv-shows",
    "tmdb"
  ],
  "author": "Salvador",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.21.4",
    "eslint": "^8.57.0",
    "obsidian": "latest",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
